# 이 파일은 "어떤 환경 변수가 필요한지"만 알려주는 템플릿입니다. 값은 직접 채워서 .env로 복사해 쓰세요.
# (.env 와 서비스 계정 키 JSON 은 절대 커밋하지 않습니다)

# 필수: OpenAI API 키
OPENAI_API_KEY=

# 필수: Firebase 서비스 계정 키. 로컬은 JSON 파일 경로, Render는 JSON 내용 전체
FIREBASE_SERVICE_ACCOUNT_JSON=

# 선택: 채팅 모델 (기본 gpt-5-mini)
OPENAI_MODEL=gpt-5-mini

# 선택: CORS 허용 도메인(쉼표로 구분). 비우면 전체 허용
ALLOWED_ORIGINS=http://localhost:5500,https://mon-cher-barre.vercel.app
